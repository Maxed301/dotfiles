font-family = JetBrainsMono Nerd Font
font-size = 15

# Kanagawa Dragon: muted, earthy palette with neutral text, so red only
# shows up where it means something (errors, git deletions).
theme = Kanagawa Dragon
# Berserk accents
cursor-color = #b31b1b
selection-background = #4A0000
selection-foreground = #e6e6e6
background-opacity = 0.95

# Dragon's ANSI colours are very desaturated; same hues, ~2-3x saturation
palette = 1=#f15c50
palette = 2=#91b96b
palette = 3=#e8c475
palette = 4=#7cb4cf
palette = 5=#b889bb
palette = 6=#83beb9
palette = 9=#f36978
palette = 10=#78c778
palette = 11=#f4c97b
palette = 12=#66c9f3
palette = 13=#927cc6
palette = 14=#66cbb8

command = /usr/bin/fish --login --interactive
shell-integration = fish

# Hyprland + hyprbars already draw a titlebar - no GTK header bar on top of it
window-decoration = none
gtk-single-instance = true
confirm-close-surface = false
copy-on-select = clipboard
