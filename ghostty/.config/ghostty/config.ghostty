font-family = JetBrainsMono Nerd Font
font-size = 18

# Kanagawa Dragon: muted, earthy palette with neutral text, so red only
# shows up where it means something (errors, git deletions).
theme = Kanagawa Dragon
# Berserk accents
cursor-color = #b31b1b
foreground = #ffffff
selection-background = #4A0000
selection-foreground = #e6e6e6

# Dragon's ANSI colours are very desaturated; same hues, ~2-3x saturation
palette = 1=#f15c50
palette = 2=#91b96b
palette = 3=#e8c475
palette = 4=#7cb4cf
palette = 5=#b889bb
palette = 6=#83beb9
palette = 9=#f36978
palette = 10=#78c778
palette = 11=#f4c97b
palette = 12=#66c9f3
palette = 13=#927cc6
palette = 14=#66cbb8

shell-integration = fish
confirm-close-surface = false
copy-on-select = clipboard

# shift+Enter sends a literal newline (ESC CR), for multi-line input
keybind = shift+enter=text:\x1b\r

# Linux-only settings live in the ghostty-linux package. On macOS the file is
# absent and the `?` makes the include a no-op. macOS settings live in the
# ghostty-macos package, which Ghostty loads from its own config path.
config-file = ?../ghostty-linux/linux.ghostty
